# Copy to .env and fill in. Never commit the real .env — it's already in .gitignore.

# --- Snowflake (from your free trial account) ---
SNOWFLAKE_ACCOUNT=xy12345.us-east-1          # the identifier in your Snowflake URL, before .snowflakecomputing.com
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=CKG_DEMO_WH
SNOWFLAKE_DATABASE=CKG_DEMO
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN                   # fine for a personal trial account; scope down for anything shared

# --- Anthropic (used two ways in this demo, see README "Two paths to Claude") ---
# 1. Direct: the hybrid agent (src/agent.py) calls this API for tool-use orchestration.
ANTHROPIC_API_KEY=sk-ant-...

# 2. Via Cortex: no key needed here — AI_COMPLETE('claude-sonnet-5', ...) calls Claude
#    *through* your Snowflake account's own Cortex entitlement. That's what makes it
#    "Claude via the Cortex API" rather than a second, separate Anthropic bill.
